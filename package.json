{
  "name": "yourgame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev-server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "check": "node scripts/check.mjs",
    "build": "node scripts/check.mjs --test",
    "db:init": "node --env-file-if-exists=.env.local scripts/init-db.mjs",
    "health": "node scripts/check-health.mjs --once"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "google-auth-library": "11.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
