    "cards": [
      {
        "id": "stone-rampart",
        "name": {
          "en": "Stone Rampart",
          "ko": "석조 성벽"
        },
        "description": {
          "en": "Add strong defense to one selected hex.",
          "ko": "선택한 타일 하나에 강한 방어를 추가합니다."
        }
      },
      {
        "id": "watch-beacon",
        "name": {
          "en": "Watch Beacon",
          "ko": "감시 봉화"
        },
        "description": {
          "en": "Add defense to one selected hex while conserving resources.",
          "ko": "자원을 아끼며 선택한 타일 하나에 방어를 추가합니다."
        }
      },
      {
        "id": "granary-charter",
        "name": {
          "en": "Granary Charter",
          "ko": "곡물창고 칙령"
        },
        "description": {
          "en": "Gain food to sustain the realm through later waves.",
          "ko": "이후 공세를 버틸 수 있도록 식량을 얻습니다."
        }
      },
      {
        "id": "fair-levy",
        "name": {
          "en": "Fair Levy",
          "ko": "공정 징세"
        },
        "description": {
          "en": "Adopt a measured tax policy to gain gold.",
          "ko": "절제된 세금 정책을 시행해 금화를 얻습니다."
        }
      },
      {
        "id": "guild-forge",
        "name": {
          "en": "Guild Forge",
          "ko": "길드 제련소"
        },
        "description": {
          "en": "Invest in industry to gain gold and reinforce one selected hex.",
          "ko": "산업에 투자해 금화를 얻고 선택한 타일 하나를 보강합니다."
        }
      },
      {
        "id": "village-council",
        "name": {
          "en": "Village Council",
          "ko": "마을 평의회"
        },
        "description": {
          "en": "Raise morale through a civic policy and steady the realm.",
          "ko": "시민 정책으로 민심을 높여 왕국을 안정시킵니다."
        }
      },
      {
        "id": "relief-caravan",
        "name": {
          "en": "Relief Caravan",
          "ko": "구호 마차대"
        },
        "description": {
          "en": "Restore health and deliver food to the growing settlement.",
          "ko": "체력을 회복하고 성장하는 정착지에 식량을 전달합니다."
        }
      },
      {
