  "copy": {
    "title": {
      "en": "Founder's Hex: First Realm",
      "ko": "창립자의 헥스: 최초의 왕국"
    },
    "subtitle": {
      "en": "Raise a lone keep into a realm across six waves.",
      "ko": "여섯 공세를 넘어 외로운 성채를 왕국으로 키우세요."
    },
    "story": {
      "en": "A lone founder claims a forgotten seven-hex valley. Choose a defense card, select a tile, and withstand each shown attack. Policies, taxes, public spirit, and industry shape your deck as the keep grows into a town and then a kingdom. After each of the first five cleared waves, add one offered card to the deck.",
      "ko": "한 명의 창립자가 잊힌 일곱 육각 타일 계곡에 터를 잡습니다. 방어 카드를 고르고 타일을 선택해 표시된 공격을 막으세요. 정책, 세금, 민심, 산업 선택은 덱을 바꾸며 성채는 마을을 거쳐 왕국으로 성장합니다. 첫 다섯 공세는 돌파할 때마다 제시된 카드 한 장을 덱에 추가합니다."
    },
    "victory": {
      "en": "The sixth wave breaks against your seven hexes. The lone keep now stands as a kingdom shaped by your deck.",
      "ko": "여섯 번째 공세가 일곱 타일 앞에서 무너졌습니다. 외로운 성채는 이제 당신의 덱이 빚은 왕국으로 우뚝 섭니다."
    },
    "defeat": {
      "en": "The realm has fallen. Begin again with a founder and build a different deck for the seven hexes.",
      "ko": "왕국이 무너졌습니다. 창립자를 다시 선택하고 일곱 타일을 위한 새로운 덱을 구성하세요."
    },
    "disclaimer": {
      "en": "These founders are fictional characters named after public figures. The game is not affiliated with or endorsed by them, and does not portray their real lives, statements, or conduct.",
      "ko": "이 창립자들은 공인의 이름을 딴 허구의 등장인물입니다. 본 게임은 해당 인물들과 관련이 없으며 그들의 보증을 받지 않았고, 실제 삶이나 발언 또는 행위를 묘사하지 않습니다."
    },
