{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": "npm run build",
  "regions": ["hnd1"],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "yourgame-eosin.vercel.app" }],
      "destination": "https://yourga.me/:path*",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "yourgame-hso1025-2820s-projects.vercel.app" }],
      "destination": "https://yourga.me/:path*",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "yourgame-git-main-hso1025-2820s-projects.vercel.app" }],
      "destination": "https://yourga.me/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/master", "destination": "/api/admin-page" },
    { "source": "/master/", "destination": "/api/admin-page" },
    { "source": "/admin", "destination": "/api/admin-redirect" },
    { "source": "/admin/", "destination": "/api/admin-redirect" },
    { "source": "/health.json", "destination": "/api/health" }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30,
      "includeFiles": "server/admin-page.html"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; connect-src 'self' https://accounts.google.com/gsi/; frame-src 'self' https://accounts.google.com/gsi/; img-src 'self' data: https://lh3.googleusercontent.com; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/game-frame.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'none'; img-src 'none'; font-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; worker-src 'none'; frame-ancestors 'self'" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), clipboard-read=(), clipboard-write=()" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    { "source": "/game-runtime-frame.js", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/game-runtime-engine.js", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/game-bundle.js", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] },
    {
      "source": "/master",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, private" }
      ]
    },
    {
      "source": "/master/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, private" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, private" }
      ]
    },
    {
      "source": "/admin/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, private" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
